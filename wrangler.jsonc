{
  "name": "controle-juridico",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "controle-juridico", "database_id": "COLOQUE_AQUI_O_ID_DO_BANCO" }
  ],
  "observability": { "enabled": true }
}
